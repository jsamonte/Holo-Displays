  InputLines:
    - '// @input string hostIp = "192.168.1.10" {"hint":"Only a fallback. The address is asked for on the glasses and remembered."}'
    - '// @input float hostPort = 8800 {"hint":"Fallback port. 8800 unless the host says it fell forward to another."}'
    - '// @input float displayCount = 2 {"hint":"Virtual monitors to ask the host for. Asked on the glasses the first time."}'
    - '// @input bool askEveryLaunch {"hint":"Ask for the address and display count every launch, not just the first."}'
    - '// @input Asset.InternetModule internetModule {"hint":"Optional. Left empty, the module is obtained in code."}'
    - '// @input Asset.RemoteMediaModule remoteMediaModule {"hint":"Optional. Left empty, the module is obtained in code."}'
    - '// @input SceneObject cameraObject {"hint":"Camera the gaze test uses. Leave empty to find the main camera."}'
    - '// @input Component.Text statusText {"hint":"Text showing connection state."}'
    - '// @input Asset.ObjectPrefab panelPrefab {"hint":"Optional. A prefab with a UI Kit Frame on it adds drag and resize."}'
    - "// @input Asset.RenderMesh panelMesh {\"hint\":\"Optional. Leave empty to use UI Kit's unit plane.\"}"
    - "// @input Asset.Material panelMaterial {\"hint\":\"Optional. Leave empty to use UI Kit's image material.\"}"
    - '// @input float panelWidthCm = 80 {"hint":"Panel width in centimetres. 80 = 0.8 m."}'
    - '// @input float panelDistanceCm = 100 {"hint":"Distance from the user in centimetres. 100 = 1 m."}'
    - '// @input float arcDegrees = 50 {"hint":"Total spread of the panel arc, in degrees."}'
    - '// @input float fullDegrees = 25 {"hint":"Within this many degrees of centre: stream at full rate."}'
    - '// @input float lowDegrees = 45 {"hint":"Within this many degrees: stream slowly. Beyond it: stop streaming."}'
    - '// @input float hysteresisDegrees = 5 {"hint":"Extra degrees needed to leave a tier, so glancing does not flip it."}'
    - '// @input float pixelsPerMetre = 2400 {"hint":"Pixels per metre of panel. 2400 makes a 0.8 m panel about 1920 px."}'
